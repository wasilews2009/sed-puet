# Налаштування стенду СЕД ПУЕТ. Скопіюйте в .env (або запустіть scripts/init-env.sh — він сам згенерує секрети)
# і замініть усі CHANGE_ME. Файл .env містить секрети: не передавайте і не комітьте його.

# --- Адреси, які бачить браузер -----------------------------------------------------------
# Без TLS на одному сервері: http://<сервер>:8080 і http://<сервер>:8180. З реверс-проксі: https://sed.puet.edu.ua тощо.
SED_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# На якій адресі хоста слухати (127.0.0.1 — лише локально/за реверс-проксі; 0.0.0.0 — у мережу)
SED_BIND_ADDR=127.0.0.1
SED_HTTP_PORT=8080
KEYCLOAK_HTTP_PORT=8180
MINIO_CONSOLE_PORT=9001

# --- Інфраструктура -----------------------------------------------------------------------
SED_DB_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=sed-minio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Формат: <ім'я ключа>:<base64 від 32 байт>   (openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=sed-key:CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Демо-стенд: --demo (8 підрозділів, 10 користувачів) + realm з демо-користувачами (пароль demo).
# Production: SED_MIGRATE_FLAGS= (порожньо) і KEYCLOAK_REALM_FILE=realm-puet.json (без користувачів).
SED_MIGRATE_FLAGS=--demo
KEYCLOAK_REALM_FILE=realm-puet.demo.json

# Образи (змінюйте, якщо реєстр недоступний або є локальне дзеркало)
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.7
# EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.6   (з GPU: …:1.6)

# --- Локальна LLM і ембединги -------------------------------------------------------------
# vLLM (--profile gpu): ваги з Hugging Face, під назвою SED_LLM_MODEL для API
LLM_HF_MODEL=mistralai/Mistral-Small-3.1-24B-Instruct-2503
SED_LLM_MODEL=mistral-small-3.1-24b-instruct-uk
SED_INGEST_LLM_BASE_URL=http://llm:8000/v1
SED_RAG_LLM_BASE_URL=http://llm:8000/v1
SED_INGEST_LLM_PROVIDER=vllm
SED_RAG_LLM_PROVIDER=vllm
# Ollama (--profile cpu): після старту — docker compose exec llm-ollama ollama pull mistral-small3.1:24b
# SED_LLM_MODEL=mistral-small3.1:24b
# SED_INGEST_LLM_BASE_URL=http://llm:11434/v1
# SED_RAG_LLM_BASE_URL=http://llm:11434/v1
# SED_INGEST_LLM_PROVIDER=ollama
# SED_RAG_LLM_PROVIDER=ollama
EMBEDDINGS_HF_MODEL=BAAI/bge-m3
# 1 — після першого завантаження ваг: жодних звернень до Hugging Face
HF_HUB_OFFLINE=0

# --- Застосунок ---------------------------------------------------------------------------
# Production: SED_APP_ENVIRONMENT=production. Вхід лише через Keycloak (режим dev у production заборонено).
SED_APP_ENVIRONMENT=development
SED_APP_AUTH_MODE=keycloak
# JWKS застосунок бере всередині мережі (видавця токенів compose підставляє з KEYCLOAK_PUBLIC_URL)
SED_APP_OIDC_JWKS_URL=http://keycloak:8080/realms/puet/protocol/openid-connect/certs

# --- Інжест (OCR + реквізити) -------------------------------------------------------------
SED_INGEST_MINIO_ENDPOINT=minio:9000
SED_INGEST_MINIO_SECURE=false

# --- Нормативний аудит (RAG) --------------------------------------------------------------
SED_RAG_QDRANT_URL=http://qdrant:6333
SED_RAG_QDRANT_API_KEY=CHANGE_ME
SED_RAG_EMBEDDING_BASE_URL=http://embeddings:80/v1
SED_RAG_EMBEDDING_PROVIDER=local_other
# Нормативний корпус змінюють лише ректор і проректор.
SED_RAG_CORPUS_ADMIN_ROLES=["rector","vice_rector"]

# --- Маршрути погодження і КЕП ------------------------------------------------------------
SED_ROUTING_ENVIRONMENT=development
# Імітаційний КНЕДП: підписи без юридичної сили. Лише development; у production застосунок з ним не стартує.
SED_ROUTING_KEP_ALLOW_MOCK=true
SED_ROUTING_KEP_TAX_ID_HMAC_SECRET=CHANGE_ME
SED_ROUTING_KEP_CHALLENGE_SECRET=CHANGE_ME
# Відкликати чужі ключі КЕП може ректор.
SED_ROUTING_KEP_ADMIN_ROLE=rector
SED_ROUTING_MINIO_ENDPOINT=minio:9000
SED_ROUTING_MINIO_SECURE=false
