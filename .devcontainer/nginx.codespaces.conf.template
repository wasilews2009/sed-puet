# Codespaces: як deploy/nginx/default.conf.template, плюс Keycloak під /auth на тому ж origin.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 55m;   # реєстрація файлів до 50 МБ

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ${KEYCLOAK_ORIGIN}; frame-src 'self' blob:; object-src blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # без add_header у location: інакше nginx не успадковує заголовки безпеки рівня server
    location = / { try_files /index.html =404; expires -1; }
    location /static/ { alias /usr/share/nginx/html/; expires 1y; }

    location /api/ {
        proxy_pass ${SED_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;   # синхронний інжест і аудит з LLM (див. ризики sed-app)
    }
    # Keycloak (KC_HTTP_RELATIVE_PATH=/auth). Codespaces завершує TLS, тож для Keycloak запит — https.
    # Свій add_header тут вимикає успадкування CSP інтерфейсу: сторінки Keycloak мають власну CSP.
    location /auth/ {
        add_header Referrer-Policy no-referrer always;
        proxy_pass http://keycloak:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${SED_PUBLIC_SCHEME};
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
    }
    location = /healthz { proxy_pass ${SED_API_UPSTREAM}; }
}
